{
  "name": "instantiate",
  "version": "0.1.0",
  "description": "See what is actually in your codebase. Finds dead code, semantic duplicates, concept drift.",
  "type": "module",
  "bin": {
    "instantiate": "./dist/cli.js"
  },
  "main": "./dist/api.js",
  "exports": {
    ".": "./dist/api.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typescript": "^5.6.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0"
  }
}
